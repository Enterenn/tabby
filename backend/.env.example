# Copy this file to .env and fill in the values.

# Required — at least 32 chars, not a published default.
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Required in Docker. Must not be "tabby" when DEBUG=false.
# python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=

# Used only for local (non-Docker) runs. Docker builds it from POSTGRES_PASSWORD.
DATABASE_URL=postgresql+asyncpg://tabby:CHANGE_ME@localhost:5432/tabby

DEBUG=false

# Public HTTPS origin (Nginx Proxy Manager). Example: https://tabby.landrodie.fr
PUBLIC_ORIGIN=
